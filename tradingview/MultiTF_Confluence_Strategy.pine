//@version=6
strategy("Multi-TF Confluence Strategy", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=1)

// ============================================================================
// STRATEGY: MULTI-TIMEFRAME CONFLUENCE (MOST ROBUST)
// Goal: 55-65% win rate, 1:2 risk/reward
// Logic: Confluence of 4H trend + Daily S/R + H1 RSI extreme
// ============================================================================

// ============================================================================
// PARAMETERS
// ============================================================================

// 4H Trend (EMA)
ema_period_4h = input(200, "4H EMA Period", group="4H Trend")

// Daily S/R (Swing Points)
swing_lookback_daily = input(20, "Daily Swing Lookback", group="Daily S/R")

// H1 Entry (RSI)
rsi_period = input(14, "RSI Period", group="H1 Entry")
rsi_oversold = input(30, "RSI Oversold", group="H1 Entry")
rsi_overbought = input(70, "RSI Overbought", group="H1 Entry")

// Exit Management
atr_period = input(14, "ATR Period", group="Exit Management")
atr_mult_sl = input(1.5, "Stop Loss (ATR multiplier)", group="Exit Management")
atr_mult_tp = input(2.0, "Take Profit (ATR multiplier)", group="Exit Management")
max_hold_bars = input(80, "Max Hold Bars", group="Exit Management")

// ============================================================================
// INDICATORS - MULTI-TIMEFRAME
// ============================================================================

// 4H EMA Bias
ema_4h = request.security(syminfo.tickerid, "240", ta.ema(close, ema_period_4h))
close_4h = request.security(syminfo.tickerid, "240", close)
trend_bias_long = close_4h > ema_4h
trend_bias_short = close_4h < ema_4h

// Daily S/R
daily_high = request.security(syminfo.tickerid, "D", high)
daily_low = request.security(syminfo.tickerid, "D", low)
daily_close = request.security(syminfo.tickerid, "D", close)

// Daily swing levels
daily_swing_high = request.security(syminfo.tickerid, "D", ta.highest(high, swing_lookback_daily))
daily_swing_low = request.security(syminfo.tickerid, "D", ta.lowest(low, swing_lookback_daily))

// H1 RSI
rsi = ta.rsi(close, rsi_period)
atr = ta.atr(atr_period)

// ============================================================================
// ENTRY CONDITIONS
// ============================================================================

// LONG: 4H trend UP + price bounce from daily low + H1 RSI oversold
price_bounce_from_daily_low = close >= daily_swing_low - atr and close <= daily_swing_low + atr * 0.5
rsi_oversold_signal = rsi < rsi_oversold
confluence_long = trend_bias_long and price_bounce_from_daily_low and rsi_oversold_signal

// SHORT: 4H trend DOWN + price bounce from daily high + H1 RSI overbought
price_bounce_from_daily_high = close <= daily_swing_high + atr and close >= daily_swing_high - atr * 0.5
rsi_overbought_signal = rsi > rsi_overbought
confluence_short = trend_bias_short and price_bounce_from_daily_high and rsi_overbought_signal

// ============================================================================
// POSITION TRACKING
// ============================================================================

var float entry_price = na
var float stop_loss = na
var float take_profit = na
var int entry_side = 0  // 1 = LONG, -1 = SHORT
var int entry_bar = 0

pip_value = 10000

// LONG Entry
if confluence_long and entry_side == 0
    entry_price := close
    stop_loss := daily_swing_low - atr_mult_sl * atr
    take_profit := close + atr_mult_tp * atr
    entry_side := 1
    entry_bar := bar_index
    strategy.entry("LONG", strategy.long, alert_message="Confluence LONG at " + str.tostring(close, "#.#####"))

// SHORT Entry
if confluence_short and entry_side == 0
    entry_price := close
    stop_loss := daily_swing_high + atr_mult_sl * atr
    take_profit := close - atr_mult_tp * atr
    entry_side := -1
    entry_bar := bar_index
    strategy.entry("SHORT", strategy.short, alert_message="Confluence SHORT at " + str.tostring(close, "#.#####"))

// ============================================================================
// EXIT LOGIC
// ============================================================================

if entry_side != 0
    // Max hold bars
    if bar_index - entry_bar >= max_hold_bars
        strategy.close(entry_side == 1 ? "LONG" : "SHORT", alert_message="Max bars reached")
        entry_side := 0
    
    // LONG exits
    if entry_side == 1
        // Stop loss
        if close <= stop_loss
            strategy.close("LONG", alert_message="SL hit at " + str.tostring(close, "#.#####"))
            entry_side := 0
        // Take profit
        if close >= take_profit
            strategy.close("LONG", alert_message="TP hit at " + str.tostring(close, "#.#####"))
            entry_side := 0
    
    // SHORT exits
    if entry_side == -1
        // Stop loss
        if close >= stop_loss
            strategy.close("SHORT", alert_message="SL hit at " + str.tostring(close, "#.#####"))
            entry_side := 0
        // Take profit
        if close <= take_profit
            strategy.close("SHORT", alert_message="TP hit at " + str.tostring(close, "#.#####"))
            entry_side := 0

// ============================================================================
// VISUALIZATION
// ============================================================================

// 4H EMA (on H1 chart)
plot(ema_4h, "4H EMA200", color=color.new(color.orange, 50), linewidth=2)

// Daily S/R Levels
plot(daily_swing_high, "Daily High", color=color.new(color.red, 50), linewidth=1)
plot(daily_swing_low, "Daily Low", color=color.new(color.green, 50), linewidth=1)

// Entry signals
plotshape(confluence_long, "Long Entry", shape.labelup, location=location.belowbar, color=color.green, size=size.small)
plotshape(confluence_short, "Short Entry", shape.labeldown, location=location.abovebar, color=color.red, size=size.small)

// Stop loss and take profit (plot unconditionally, set to na if flat)
plot_sl = entry_side != 0 ? stop_loss : na
plot_tp = entry_side != 0 ? take_profit : na
plot(plot_sl, "SL", color=color.red, linewidth=1, style=plot.style_linebr)
plot(plot_tp, "TP", color=color.green, linewidth=1, style=plot.style_linebr)

// RSI reference lines
hline(50, "RSI Mid", color=color.gray, linestyle=hline.style_dashed)
hline(rsi_oversold, "RSI OS", color=color.green, linestyle=hline.style_dashed)
hline(rsi_overbought, "RSI OB", color=color.red, linestyle=hline.style_dashed)

// ============================================================================
// INFO BOX
// ============================================================================

var label previous_label = na

info_text = ""
info_text += "4H Trend: " + (trend_bias_long ? "UP ↑" : "DOWN ↓")
info_text += "\n4H EMA: " + str.tostring(ema_4h, "#.#####")
info_text += "\nDaily High: " + str.tostring(daily_swing_high, "#.#####")
info_text += "\nDaily Low: " + str.tostring(daily_swing_low, "#.#####")
info_text += "\nH1 RSI: " + str.tostring(rsi, "#.#")
info_text += "\nEntry Side: " + (entry_side == 0 ? "FLAT" : entry_side == 1 ? "LONG" : "SHORT")
if entry_side != 0
    info_text += "\nEntry: " + str.tostring(entry_price, "#.#####")
    info_text += "\nSL: " + str.tostring(stop_loss, "#.#####")
    info_text += "\nTP: " + str.tostring(take_profit, "#.#####")

if not na(previous_label)
    label.delete(previous_label)

previous_label := label.new(bar_index, high + atr*2, info_text, xloc=xloc.bar_time, style=label.style_label_center, 
                       color=color.new(color.blue, 80), textcolor=color.white, size=size.small)
