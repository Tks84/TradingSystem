//@version=6
strategy("S/R Bounce Strategy", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=1)

// ============================================================================
// STRATEGY: SUPPORT/RESISTANCE BOUNCE (HIGH WIN RATE)
// Goal: 65-75% win rate, 1:1 to 1.5 risk/reward
// Logic: Bounce from daily S/R levels on H1 with RSI confirmation
// ============================================================================

// ============================================================================
// PARAMETERS
// ============================================================================

// Swing Point Detection (Daily Timeframe)
swing_lookback = input(20, "Swing Lookback (Daily)", group="Swing Detection")

// Bounce Confirmation
rsi_period = input(14, "RSI Period", group="Entry Signals")
rsi_oversold = input(30, "RSI Oversold (LONG)", group="Entry Signals")
rsi_overbought = input(70, "RSI Overbought (SHORT)", group="Entry Signals")

// Exit Management
atr_period = input(14, "ATR Period", group="Exit Management")
atr_mult_sl = input(1.5, "Stop Loss (ATR multiplier)", group="Exit Management")
atr_mult_tp = input(1.5, "Take Profit (ATR multiplier)", group="Exit Management")

// Risk Management
risk_pct = input(1.0, "Risk % of Equity", group="Risk Management")
commission_pips = input(0.2, "Commission (pips)", group="Risk Management")

// ============================================================================
// INDICATORS
// ============================================================================

// Daily S/R Levels (using request.security to get daily data on H1 chart)
daily_high = request.security(syminfo.tickerid, "D", high)
daily_low = request.security(syminfo.tickerid, "D", low)
daily_close = request.security(syminfo.tickerid, "D", close)

// H1 Indicators
rsi = ta.rsi(close, rsi_period)
atr = ta.atr(atr_period)

// Swing highs/lows on daily timeframe (simplified)
daily_swing_high = request.security(syminfo.tickerid, "D", ta.highest(high, swing_lookback))
daily_swing_low = request.security(syminfo.tickerid, "D", ta.lowest(low, swing_lookback))

// ============================================================================
// ENTRY LOGIC
// ============================================================================

// LONG Entry: Price near daily low (support) + RSI oversold
price_near_support = close >= daily_swing_low - atr and close <= daily_swing_low + atr * 0.5
rsi_oversold_signal = rsi < rsi_oversold
bullish_candle = close > open

long_entry = price_near_support and rsi_oversold_signal and bullish_candle

// SHORT Entry: Price near daily high (resistance) + RSI overbought
price_near_resistance = close <= daily_swing_high + atr and close >= daily_swing_high - atr * 0.5
rsi_overbought_signal = rsi > rsi_overbought
bearish_candle = close < open

short_entry = price_near_resistance and rsi_overbought_signal and bearish_candle

// ============================================================================
// POSITION TRACKING
// ============================================================================

var float entry_price = na
var float stop_loss = na
var float take_profit = na
var int entry_side = 0  // 1 = LONG, -1 = SHORT
var int entry_bar = 0

pip_value = 10000

// LONG Entry
if long_entry and entry_side == 0
    entry_price := close
    stop_loss := daily_swing_low - atr_mult_sl * atr
    take_profit := close + atr_mult_tp * atr
    entry_side := 1
    entry_bar := bar_index
    strategy.entry("LONG", strategy.long, alert_message="LONG Bounce at " + str.tostring(close, "#.#####"))

// SHORT Entry
if short_entry and entry_side == 0
    entry_price := close
    stop_loss := daily_swing_high + atr_mult_sl * atr
    take_profit := close - atr_mult_tp * atr
    entry_side := -1
    entry_bar := bar_index
    strategy.entry("SHORT", strategy.short, alert_message="SHORT Bounce at " + str.tostring(close, "#.#####"))

// ============================================================================
// EXIT LOGIC
// ============================================================================

if entry_side != 0
    // LONG exits
    if entry_side == 1
        // Stop loss
        if close <= stop_loss
            strategy.close("LONG", alert_message="SL hit at " + str.tostring(close, "#.#####"))
            entry_side := 0
        // Take profit
        if close >= take_profit
            strategy.close("LONG", alert_message="TP hit at " + str.tostring(close, "#.#####"))
            entry_side := 0
    
    // SHORT exits
    if entry_side == -1
        // Stop loss
        if close >= stop_loss
            strategy.close("SHORT", alert_message="SL hit at " + str.tostring(close, "#.#####"))
            entry_side := 0
        // Take profit
        if close <= take_profit
            strategy.close("SHORT", alert_message="TP hit at " + str.tostring(close, "#.#####"))
            entry_side := 0

// ============================================================================
// VISUALIZATION
// ============================================================================

// Daily S/R Levels
plot(daily_swing_high, "Daily Swing High", color=color.new(color.red, 50), linewidth=1)
plot(daily_swing_low, "Daily Swing Low", color=color.new(color.green, 50), linewidth=1)

// Entry signals
plotshape(long_entry, "Long Entry", shape.labelup, location=location.belowbar, color=color.green, size=size.small)
plotshape(short_entry, "Short Entry", shape.labeldown, location=location.abovebar, color=color.red, size=size.small)

// Stop loss and take profit levels (plot unconditionally, set to na if flat)
plot_sl = entry_side != 0 ? stop_loss : na
plot_tp = entry_side != 0 ? take_profit : na
plot(plot_sl, "SL", color=color.red, linewidth=1, style=plot.style_linebr)
plot(plot_tp, "TP", color=color.green, linewidth=1, style=plot.style_linebr)

// RSI subplot (via hline reference)
hline(50, "RSI Mid", color=color.gray, linestyle=hline.style_dashed)
hline(rsi_oversold, "RSI OS", color=color.green, linestyle=hline.style_dashed)
hline(rsi_overbought, "RSI OB", color=color.red, linestyle=hline.style_dashed)

// ============================================================================
// INFO BOX
// ============================================================================

var label previous_label = na

info_text = ""
info_text += "RSI: " + str.tostring(rsi, "#.#")
info_text += "\nDaily High: " + str.tostring(daily_swing_high, "#.#####")
info_text += "\nDaily Low: " + str.tostring(daily_swing_low, "#.#####")
info_text += "\nEntry Side: " + (entry_side == 0 ? "FLAT" : entry_side == 1 ? "LONG" : "SHORT")
if entry_side != 0
    info_text += "\nEntry: " + str.tostring(entry_price, "#.#####")
    info_text += "\nSL: " + str.tostring(stop_loss, "#.#####")
    info_text += "\nTP: " + str.tostring(take_profit, "#.#####")

if not na(previous_label)
    label.delete(previous_label)

previous_label := label.new(bar_index, high + atr, info_text, xloc=xloc.bar_time, style=label.style_label_center, 
                       color=color.new(color.blue, 80), textcolor=color.white, size=size.small)
