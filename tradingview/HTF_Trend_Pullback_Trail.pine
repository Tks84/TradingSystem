//@version=6
strategy("HTF Trend Pullback Trail", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=1)

// ============================================================================
// PARAMETERS - Match Phase 02 Baseline
// ============================================================================

// Entry Parameters
ema_fast_period = input(50, "EMA Fast Period", group="Entry Signals")
pullback_lookback = input(5, "Pullback Lookback bars", group="Entry Signals")

// Exit Parameters
sl_pips = input(1.5, "Stop Loss (pips)", group="Exit Management")
trailing_atr_mult = input(3.0, "Trailing Stop (ATR multiplier)", group="Exit Management")
atr_period = input(14, "ATR Period", group="Exit Management")
max_bars_in_trade = input(80, "Max bars in trade", group="Exit Management")

// Daily Bias Filter
ema_daily_period = input(200, "Daily EMA for Bias", group="Daily Bias")
use_daily_bias = input(true, "Use Daily Bias filter", group="Daily Bias")
session_filter = input(false, "Use Session Filter (7-16 UTC)", group="Daily Bias")

// Session hours (UTC)
session_start_hour = input(7, "Session Start Hour (UTC)", group="Daily Bias")
session_end_hour = input(16, "Session End Hour (UTC)", group="Daily Bias")

// Risk Management
risk_pct = input(1.0, "Risk % of Equity", group="Risk Management")
commission_pips = input(0.2, "Commission (pips)", group="Risk Management")
slippage_pips = input(0.3, "Slippage (pips)", group="Risk Management")

// ============================================================================
// INDICATORS
// ============================================================================

// EMA Fast (H1)
ema_fast = ta.ema(close, ema_fast_period)

// ATR (14)
atr = ta.atr(atr_period)

// Simple trend strength: use RSI as proxy for ADX
// ADX not available in v6, so we use RSI > 50 for uptrend, RSI < 50 for downtrend
rsi_val = ta.rsi(close, 14)
trend_strong = rsi_val > 40 and rsi_val < 60 ? false : true  // Avoid ranging markets

// Daily EMA for bias (on 1D)
daily_close = request.security(syminfo.tickerid, "D", close)
daily_ema = ta.ema(daily_close, ema_daily_period)

// ============================================================================
// DAILY BIAS LOGIC
// ============================================================================

daily_bias = 0
if use_daily_bias
    if daily_close > daily_ema
        daily_bias := 1  // LONG bias
    else if daily_close < daily_ema
        daily_bias := -1  // SHORT bias
    else
        daily_bias := 0   // NO BIAS

// ============================================================================
// SESSION FILTER
// ============================================================================

in_session = true
if session_filter
    current_hour = hour(time, "UTC")
    in_session := current_hour >= session_start_hour and current_hour < session_end_hour

// ============================================================================
// PULLBACK DETECTION (5-bar lookback)
// ============================================================================

pullback_low = ta.lowest(low, pullback_lookback)
pullback_high = ta.highest(high, pullback_lookback)

// LONG pullback: low touches/crosses EMA, close above EMA, bullish candle
long_pullback = low <= ema_fast and close > ema_fast and close > open

// SHORT pullback: high touches/crosses EMA, close below EMA, bearish candle
short_pullback = high >= ema_fast and close < ema_fast and close < open

// ============================================================================
// ENTRY CONDITIONS
// ============================================================================

trend_ok = trend_strong

long_entry = trend_ok and daily_bias == 1 and in_session and long_pullback
short_entry = trend_ok and daily_bias == -1 and in_session and short_pullback

// ============================================================================
// POSITION TRACKING & EXITS
// ============================================================================

var float entry_price = na
var float entry_time_bars = na
var int entry_side = 0  // 1 = LONG, -1 = SHORT
var float stop_loss = na
var float trailing_stop = na

// Calculate stop loss distance (in pips, accounting for slippage)
// pip_value = 10000 for most pairs (e.g., EURUSD, USDJPY)
pip_value = 10000

// Entry: Open position
if long_entry and entry_side == 0
    entry_price := close
    stop_loss := close - (sl_pips + slippage_pips) / pip_value
    trailing_stop := close + (trailing_atr_mult * atr)
    entry_side := 1
    entry_time_bars := bar_index
    strategy.entry("LONG", strategy.long, alert_message="LONG entry at " + str.tostring(close, "#.#####"))

if short_entry and entry_side == 0
    entry_price := close
    stop_loss := close + (sl_pips + slippage_pips) / pip_value
    trailing_stop := close - (trailing_atr_mult * atr)
    entry_side := -1
    entry_time_bars := bar_index
    strategy.entry("SHORT", strategy.short, alert_message="SHORT entry at " + str.tostring(close, "#.#####"))

// Exit conditions
if entry_side != 0
    // Stop loss hit
    if (entry_side == 1 and close <= stop_loss) or (entry_side == -1 and close >= stop_loss)
        strategy.close(entry_side == 1 ? "LONG" : "SHORT", alert_message="SL hit at " + str.tostring(close, "#.#####"))
        entry_side := 0
    
    // Trailing stop (only for LONG: trail up; SHORT: trail down)
    if entry_side == 1
        trailing_stop := math.max(trailing_stop, close - (trailing_atr_mult * atr))
        if close <= trailing_stop
            strategy.close("LONG", alert_message="Trail stop hit at " + str.tostring(close, "#.#####"))
            entry_side := 0
    
    if entry_side == -1
        trailing_stop := math.min(trailing_stop, close + (trailing_atr_mult * atr))
        if close >= trailing_stop
            strategy.close("SHORT", alert_message="Trail stop hit at " + str.tostring(close, "#.#####"))
            entry_side := 0
    
    // Max bars in trade
    if bar_index - entry_time_bars >= max_bars_in_trade
        strategy.close(entry_side == 1 ? "LONG" : "SHORT", alert_message="Max bars reached at " + str.tostring(close, "#.#####"))
        entry_side := 0
    
    // EMA cross exit (simple: cross below/above)
    if entry_side == 1 and close < ema_fast
        strategy.close("LONG", alert_message="EMA cross exit at " + str.tostring(close, "#.#####"))
        entry_side := 0
    
    if entry_side == -1 and close > ema_fast
        strategy.close("SHORT", alert_message="EMA cross exit at " + str.tostring(close, "#.#####"))
        entry_side := 0

// ============================================================================
// VISUALIZATION
// ============================================================================

// EMA Fast
plot(ema_fast, "EMA50", color=color.blue, linewidth=2)

// Daily EMA (if available via request.security - faint)
// plot(daily_ema, "Daily EMA200", color=color.new(color.gray, 50))

// Entry signals
plotshape(long_entry, "Long Entry", shape.labelup, location=location.belowbar, color=color.green, size=size.small)
plotshape(short_entry, "Short Entry", shape.labeldown, location=location.abovebar, color=color.red, size=size.small)

// RSI centerline
hline(50, "RSI Midline", color=color.gray, linestyle=hline.style_dashed)

// ============================================================================
// INFO BOX (Dashboard integration)
// ============================================================================

var label previous_label = na

info_text = ""
info_text += "Daily Bias: " + (daily_bias == 1 ? "LONG ↑" : daily_bias == -1 ? "SHORT ↓" : "NONE")
info_text += "\nTrend: " + (trend_strong ? "STRONG" : "WEAK") + " (RSI: " + str.tostring(rsi_val, "#") + ")"
info_text += "\nEMA50: " + str.tostring(ema_fast, "#.#####")
info_text += "\nSession OK: " + (in_session ? "✓" : "✗")
info_text += "\nEntry Side: " + (entry_side == 0 ? "FLAT" : entry_side == 1 ? "LONG" : "SHORT")
if entry_side != 0
    info_text += "\nEntry: " + str.tostring(entry_price, "#.#####")
    info_text += "\nSL: " + str.tostring(stop_loss, "#.#####")
    info_text += "\nTrail: " + str.tostring(trailing_stop, "#.#####")

// Delete previous label
if not na(previous_label)
    label.delete(previous_label)

// Create new label
previous_label := label.new(bar_index, high + atr*2, info_text, xloc=xloc.bar_time, style=label.style_label_center, 
                       color=color.new(color.blue, 80), textcolor=color.white, size=size.small)
